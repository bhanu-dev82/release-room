{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "gh pr *": "ask",
      "gh repo *": "deny",
      "git reset --hard *": "deny",
      "rm -rf *": "deny"
    },
    "external_directory": "deny"
  }
}
